# Secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Scraped data (large, regenerable, and personal-scale project doesn't need it in git)
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Embedding model cache (large, binary, regenerated by render.yaml's build step)
model_cache/

# Logs
*.log

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test/coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Ruff cache
.ruff_cache/

# Eval harness run artifacts (regenerable; committed numbers live in
# evals/RESULTS.md and the README "Evals" section)
evals/results/*
!evals/results/.gitkeep

# Claude Code skill data (installed per machine, not part of the app;
# untracked 2026-09-28 - it was ~77% of the repo's tracked bytes)
.claude/skills/
skills-lock.json
